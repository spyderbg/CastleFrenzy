@echo off
setlocal EnableExtensions
pushd "%~dp0"

rem ////////////////////////////////////////
rem 		Init pack
rem ///////////////////////////////////////

set PACK_NAME=Sprites

set "PROJECT_TOOLS_PATH=%~dp0..\..\Tools"
set "HEADERS_OUT_PATH=%~dp0..\..\Src\Autogenerated"
set "OUTPUT_PATH=%~dp0..\..\Build\bin"

rem ///////////////////////////////////////

set SPRCMD_NAME=%PACK_NAME%.sprcmd
set LOG=%CD%\make%PACK_NAME%.log

rem Clean data
if "%1"=="clean" (
	call _clean.bat
	goto END
)
if "%1"=="" (
	call _clean.bat
)

rem Build data
echo.
echo **************************************************************
echo    Make %PACK_NAME%
echo **************************************************************

if not exist "bin" (
	mkdir bin
)
if exist "bin\*.h" (
	del /s /q bin\*.h
)

rem Create 'sprcmd' file for AuroraMX
echo // Copy YAML metadata unchanged and generate runtime ID headers. > %SPRCMD_NAME%

rem Remove all bkp files
echo.
echo Delete all bakcup files generated from the sprite editor
echo.
del /Q /S .\*.bak
echo.

rem  Go through all sprite directories
for /D %%d in (*.) do (
	if not "%%d"=="bin" (
	
		if not exist bin\%%d (
			mkdir bin\%%d
		)
		
		echo.																			>> %SPRCMD_NAME%				
		echo.																			>> %SPRCMD_NAME%				
		echo //---------------------------------------------------						>> %SPRCMD_NAME%						
		echo // Copy %%d YAML and generate IDs																>> %SPRCMD_NAME%
		echo //---------------------------------------------------						>> %SPRCMD_NAME%						
		echo.																			>> %SPRCMD_NAME%				
				
		rem Generate sprite command file for current dir
		for %%f in (%%d\*.yaml) do (
			if exist "%%f" (
				echo Load(^"%%f^"^) >> %SPRCMD_NAME%
				echo ExportFramesID(^"bin\%%d.h^", ^"%%d_F_%%~nf_^", APPEND^|TOUPPER^) >> %SPRCMD_NAME%
				echo ExportAnimsID(^"bin\%%d.h^", ^"%%d_A_%%~nf_^", APPEND^|TOUPPER^) >> %SPRCMD_NAME%
				echo Copy(^"bin\%%d\%%~nf.yaml^"^) >> %SPRCMD_NAME%
			)
		)

		for %%f in (%%d\*.png) do (
			if exist "%%f" copy /Y "%%f" "bin\%%d" > NUL
		)

	)
)

if not exist "%PROJECT_TOOLS_PATH%\AuroraMX\node_modules\.bin\esbuild.cmd" (
    call npm ci --prefix "%PROJECT_TOOLS_PATH%\AuroraMX" --no-audit --no-fund
    if errorlevel 1 goto FAILED
)
call npm run build:cli --prefix "%PROJECT_TOOLS_PATH%\AuroraMX"
if errorlevel 1 goto FAILED
node "%PROJECT_TOOLS_PATH%\AuroraMX\build\cli.cjs" batch "%CD%\%SPRCMD_NAME%"
if errorlevel 1 goto FAILED

rem Copy generated files
for %%f in (bin\*.h) do (
	if not exist %HEADERS_OUT_PATH%\%%~nf.h (
		move /Y %%f %HEADERS_OUT_PATH%
	) else (		
		FC %%f %HEADERS_OUT_PATH%\%%~nf.h | FIND "FC: no dif" > nul 
		if ERRORLEVEL 1 ( 
			move /Y %%f %HEADERS_OUT_PATH%
		) else (
			del /Q /S %%f > nul
		)
	)
)

rem Copy data to temp directory
rem if not exist %TEMP_PATH%\%PACK_NAME% (
rem 	mkdir %TEMP_PATH%\%PACK_NAME%
rem )
rem xcopy /S /Y bin %TEMP_PATH%\%PACK_NAME%
rem rmdir /S /Q bin


rem Build bar file or not
if not "%1"=="no_bar" (
	echo.
	echo **************************************************************
	echo    Achiving %PACK_NAME%
	echo **************************************************************
	
	rem del /Q %OUTPUT_PATH%\%PACK_NAME%.bar
	
	rem copy /Y %OUTPUT_PATH%\%PACK_NAME%.bar %OUTPUT_PATH_WII%\%PACK_NAME%.bar
	
	if not exist %OUTPUT_PATH%\%PACK_NAME% (
		mkdir %OUTPUT_PATH%\%PACK_NAME%
	)
	rem Remove obsolete sprite metadata from previous builds.
	del /S /Q "%OUTPUT_PATH%\%PACK_NAME%\*.bsprite" "%OUTPUT_PATH%\%PACK_NAME%\*.sprite" 2>NUL
	xcopy /S /Y bin %OUTPUT_PATH%\%PACK_NAME%
	rmdir bin	

	if ERRORLEVEL 1 ( 
		echo.
		echo ERROR ERROR ERROR ERROR ERROR ERROR ERROR ERROR ERROR ERROR
		echo.
		pause
		goto END
	)

	for %%f in (%OUTPUT_PATH%\*.h) do (
		if not exist %HEADERS_OUT_PATH%\%%~nf.h (
			move /Y %%f %HEADERS_OUT_PATH%
		) else (		
			FC %%f %HEADERS_OUT_PATH%\%%~nf.h | FIND "FC: no dif" > nul 
			if ERRORLEVEL 1 ( 
				move /Y %%f %HEADERS_OUT_PATH%
			) else (
				del /Q /S %%f > nul 
			)
		)
	)	

)

:END
popd
endlocal
exit /b 0

:FAILED
popd
endlocal
exit /b 1

