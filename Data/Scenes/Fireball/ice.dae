      <extra>
        <technique profile="FCOLLADA">
          <start_time>0</start_time>
          <end_time>3.33333</end_time>
        </technique>
      </extra>
      <extra>
        <technique profile="MAX3D">
          <frame_rate>30</frame_rate>
        </technique>
