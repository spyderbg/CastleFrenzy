  </library_materials>
  <library_effects>
    <effect id="Standard_1-fx" name="Standard_1">
      <profile_COMMON>
        <newparam sid="goblin_shadow_tga-surface">
          <surface type="2D">
            <init_from>goblin_shadow.png</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="goblin_shadow_tga-sampler">
          <sampler2D>
            <source>goblin_shadow_tga-surface</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
            <minfilter>NONE</minfilter>
            <magfilter>NONE</magfilter>
            <mipfilter>NONE</mipfilter>
          </sampler2D>
        </newparam>
        <newparam sid="goblin_shadow_tga-surface">
